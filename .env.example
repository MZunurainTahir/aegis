# ============================================================
# AEGIS v3.0 — Autonomous Risk-Governed Options Income Desk
# Copy to .env and fill in what you have. Only the Alpaca keys
# are required; every other integration degrades gracefully.
# ============================================================

# ---------- Alpaca Brokerage (REQUIRED) ----------
# Paper keys from https://app.alpaca.markets/paper/dashboard/overview
# The hackathon requires a dedicated paper account seeded with $100,000.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ---------- AI Inference (multi-LLM ensemble) ----------
# The LLM Manager fails over across every configured provider, in order:
# Groq -> Cerebras -> Gemini -> DeepSeek -> Mistral -> OpenRouter.
# Configure at least one; more providers = higher consensus quality.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=          # GitHub Models inference (optional)
HF_TOKEN=              # Hugging Face (optional)

# ---------- Voice Narration (optional) ----------
# Used by the AI voice briefing on the dashboard.
ELEVENLABS_API_KEY=

# ---------- Telegram Alerts (optional) ----------
# 1. Create a bot via @BotFather on Telegram -> copy the token.
# 2. Message your bot once, then get your chat id from @userinfobot.
# When both are set, AEGIS pushes live trade/veto/hedge/cycle alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Supabase (optional, legacy) ----------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
